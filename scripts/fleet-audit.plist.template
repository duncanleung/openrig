<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Install steps are in the header of scripts/fleet-audit.sh. Replace __SCRIPT__ and __HOME__. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.openrig.fleet-audit</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__SCRIPT__</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/.openrig/fleet-audit/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.openrig/fleet-audit/launchd.log</string>
</dict>
</plist>
