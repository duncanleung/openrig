+// Deterministic verdicts (RIG-10). This Workflow runs no deterministic check itself. A caller that
+// ran deterministic-check.mjs (code-review-validate-findings) can pass the results as
+// _args.deterministicResults = [{ file, lines, verdict, method }]; they are matched by file and lines.
+const DET_VERDICTS = ['confirmed', 'refuted', 'inconclusive']
+const DET_METHODS = ['tsc', 'vitest', 'eslint']
+
+function deterministicFor(finding) {
+  const list = Array.isArray(_args.deterministicResults) ? _args.deterministicResults : []
+  const d = list.find(r => r && r.file === finding.file && String(r.lines) === String(finding.lines))
+  if (!d || !DET_VERDICTS.includes(d.verdict) || !DET_METHODS.includes(d.method)) return null
+  return d
 }
 
+// Deterministic verdict wins. Otherwise the LLM verdict: MUST_FIX is a true positive, DISMISSED a
+// false positive. SUGGESTION, ESCALATED and SMELL stay unlabeled. --annotate still overwrites later.
+function outcomeFor(det, verdict) {
+  if (det && det.verdict === 'confirmed') return { outcome_label: 'true_positive', outcome_source: 'deterministic' }
+  if (det && det.verdict === 'refuted') return { outcome_label: 'false_positive', outcome_source: 'deterministic' }
+  if (verdict === 'MUST_FIX') return { outcome_label: 'true_positive', outcome_source: 'llm_validator' }
+  if (verdict === 'DISMISSED') return { outcome_label: 'false_positive', outcome_source: 'llm_validator' }
+  return { outcome_label: null, outcome_source: null }
+}
