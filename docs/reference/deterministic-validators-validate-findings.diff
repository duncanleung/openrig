+#!/usr/bin/env node
+// Deterministic pre-validation checks for /code-review-validate-findings (RIG-10).
+//
+// The Workflow script cannot start processes (no Node API access), so the invoking session runs
+// this helper BEFORE it launches the Workflow and passes the verdicts in as args. Design doc:
+// docs/reference/deterministic-validators.md in the openrig repo.
+//
+// Usage:
+//   node deterministic-check.mjs --repo <root> --head-sha <sha> \
+//        --findings <findings.json> --diff-files <diff-files.json> [--out <results.json>]
+//
+// Finding text is untrusted. It is read from a JSON file, never from argv, and it never reaches a
+// process argument. Every command is an argv array run with shell:false from a fixed allowlist.
+
+import { execFile } from 'node:child_process'
+import { readFileSync, writeFileSync, realpathSync, statSync, existsSync } from 'node:fs'
+import { dirname, join, relative, resolve, sep, isAbsolute } from 'node:path'
+import { promisify } from 'node:util'
+
+const execFileP = promisify(execFile)
+
+export const TIMEOUT_MS = 180_000
+export const MAX_OUTPUT_BYTES = 8 * 1024 * 1024
+const EVIDENCE_CHARS = 600
+
+export const VERDICTS = ['confirmed', 'refuted', 'inconclusive']
+export const METHODS = ['tsc', 'vitest', 'eslint']
+
+const inconclusive = (method, reason) => ({ verdict: 'inconclusive', method, reason })
+
+// ── Classification ──────────────────────────────────────────────────────────
+
+const KIND_TO_METHOD = { 'type-error': 'tsc', 'test-failure': 'vitest', lint: 'eslint' }
+const TS_CODE_RE = /\bTS\d{4}\b/
+const TSC_RE = /\bTS\d{4}\b|does not compile|\bfails?\s+(to\s+)?type[- ]?check|\bcompile errors?\b/i
+// A case-sensitive TypeError is the runtime class. A compiler cannot refute it.
+const RUNTIME_TYPEERROR_RE = /\bTypeError\b/
+const VITEST_RE = /\bvitest\b|\b(failing|failed|broken)\s+tests?\b|\btests?\s+(is\s+|are\s+|will\s+)?(fail|failing|failure)/i
+// The finding says a test itself fails ("failing test helper" does not).
+const VITEST_FAILS_RE = /\btests?\b[^.\n]{0,80}\b(fails?|failing|failed|breaks?)\b|\b(failing|failed|broken)\s+tests?\b(?!\s+(helper|util|utils|fixture|mock|setup))/i
+// A conditional or intermittent claim ("flaky", "in a different timezone", "on CI"). One clean local
+// run cannot refute it. Heuristic: it only looks at the first 300 characters.
+const QUALIFIER_RE = /\b(flaky|flake|flakes|intermittent(ly)?|sometimes|occasionally|nondeterministic\w*|race|order[- ]dependent|timezone|time zone|locale|only (on|in|when|under|with)|on CI|in CI|when run (in|on|with)|under load)\b/i
+const ESLINT_RE = /\beslint\b|\blint(er|ing)?\b/i
+
+// Returns { method, classifiedBy } or null.
+//   structured: finding.deterministicKind, set by the invoking session.
+//   ts-code:    keyword path, tsc, and the text holds an explicit TSnnnn code.
+//   keyword:    any other keyword match.
+// Structured field first. Keyword fallback only on category plus the first 300 characters of the
+// description. More than one match, or none, means no check.
+export function classifyFindingDetailed(finding) {
+  if (!finding || typeof finding !== 'object') return null
+  if (typeof finding.deterministicKind === 'string') {
+    const method = KIND_TO_METHOD[finding.deterministicKind]
+    return method ? { method, classifiedBy: 'structured' } : null
+  }
+  const text = `${finding.category || ''} ${String(finding.description || '').slice(0, 300)}`
+  const hits = []
+  if (TSC_RE.test(text) && !RUNTIME_TYPEERROR_RE.test(text)) hits.push('tsc')
+  if (VITEST_RE.test(text)) hits.push('vitest')
+  if (ESLINT_RE.test(text)) hits.push('eslint')
+  if (hits.length !== 1) return null
+  const method = hits[0]
+  return { method, classifiedBy: method === 'tsc' && TS_CODE_RE.test(text) ? 'ts-code' : 'keyword' }
+}
+
+export function classifyFinding(finding) {
+  const c = classifyFindingDetailed(finding)
+  return c ? c.method : null
+}
+
+// A clean run refutes a claim only if the claim itself is known, not guessed from keywords.
+//   tsc:    structured kind or an explicit TSnnnn code.
+//   vitest: structured kind, or the finding names a test file (checked by the caller), says it fails,
+//           and makes no conditional or intermittent claim (QUALIFIER_RE).
+//   eslint: always; checkEslint already needs a named, enabled rule.
+export function refuteAllowed(method, classifiedBy, finding) {
+  if (method === 'eslint') return true
+  if (classifiedBy === 'structured') return true
+  if (method === 'tsc') return classifiedBy === 'ts-code'
+  if (method === 'vitest') {
+    const text = `${finding.category || ''} ${String(finding.description || '').slice(0, 300)}`
+    return VITEST_FAILS_RE.test(text) && !QUALIFIER_RE.test(text)
+  }
+  return false
+}
+
+// "42", "42-50", "L42-L50", "42,50" -> {start, end}; anything else -> null (no line claimed).
+export function parseLines(lines) {
+  const m = String(lines == null ? '' : lines).match(/(\d+)\D+L?(\d+)|(\d+)/)
+  if (!m) return null
+  const a = Number(m[1] || m[3])
+  const b = Number(m[2] || m[3])
+  return { start: Math.min(a, b), end: Math.max(a, b) }
+}
+
+const inRange = (line, range) => !range || (line >= range.start && line <= range.end)
+
+// ── Path validation ─────────────────────────────────────────────────────────
+
+// Returns { ok: true, rel, real } or { ok: false, reason }. `rel` is repo-relative with forward
+// slashes and never starts with "-". `real` is the symlink-resolved absolute path.
+export function validateRepoPath(root, candidate) {
+  if (typeof candidate !== 'string' || candidate === '') return { ok: false, reason: 'empty-path' }
+  if (candidate.includes('\0')) return { ok: false, reason: 'nul-byte' }
+  if (candidate.startsWith('-')) return { ok: false, reason: 'leading-dash' }
+  if (candidate.split(/[\\/]/).includes('..')) return { ok: false, reason: 'parent-segment' }
+  let realRoot
+  try {
+    realRoot = realpathSync(root)
+  } catch {
+    return { ok: false, reason: 'root-missing' }
+  }
+  const abs = isAbsolute(candidate) ? candidate : resolve(realRoot, candidate)
+  let real
+  try {
+    real = realpathSync(abs)
+  } catch {
+    return { ok: false, reason: 'not-found' }
+  }
+  if (real !== realRoot && !real.startsWith(realRoot + sep)) return { ok: false, reason: 'outside-root' }
+  let st
+  try {
+    st = statSync(real)
+  } catch {
+    return { ok: false, reason: 'not-found' }
+  }
+  if (!st.isFile()) return { ok: false, reason: 'not-a-file' }
+  const rel = relative(realRoot, real).split(sep).join('/')
+  if (rel.startsWith('-') || rel.startsWith('..')) return { ok: false, reason: 'unsafe-relative-path' }
+  return { ok: true, rel, real }
+}
+
+// A path from the finding must be a file the PR changes. Test files are the one exception: the
+// finding may name a test file the PR does not touch, if it exists at the PR head.
+export function resolveClaimedPath(root, candidate, diffFiles, { allowNonDiff = false } = {}) {
+  const v = validateRepoPath(root, candidate)
+  if (!v.ok) return v
+  if (!allowNonDiff && !(diffFiles || []).includes(v.rel)) return { ok: false, reason: 'not-in-pr-diff' }
+  return v
+}
+
+const TEST_FILE_RE = /\.(test|spec)\.[cm]?[jt]sx?$/
+
+// Test file for a vitest check: the finding's own file if it is a test file, else the first
+// test-file path the description names that passes path validation.
+export function findTestFile(root, finding) {
+  const direct = String(finding.file || '')
+  if (TEST_FILE_RE.test(direct)) {
+    const v = validateRepoPath(root, direct)
+    if (v.ok) return v
+  }
+  const named = String(finding.description || '').match(/[\w@./-]+\.(?:test|spec)\.[cm]?[jt]sx?/g) || []
+  for (const n of named) {
+    const v = validateRepoPath(root, n)
+    if (v.ok) return v
+  }
+  return null
+}
+
+// Nearest tsconfig.json at or above the claimed file, never above the repo root.
+export function findTsconfig(root, fileReal) {
+  const realRoot = realpathSync(root)
+  let dir = dirname(fileReal)
+  while (dir === realRoot || dir.startsWith(realRoot + sep)) {
+    const candidate = join(dir, 'tsconfig.json')
+    if (existsSync(candidate)) return validateRepoPath(realRoot, candidate)
+    if (dir === realRoot) break
+    dir = dirname(dir)
+  }
+  return { ok: false, reason: 'no-tsconfig' }
+}
+
+// Local binary only. Never PATH, never npx.
+export function findLocalBin(root, name, fileReal) {
+  const realRoot = realpathSync(root)
+  let dir = dirname(fileReal)
+  while (dir === realRoot || dir.startsWith(realRoot + sep)) {
+    const candidate = join(dir, 'node_modules', '.bin', name)
+    if (existsSync(candidate)) {
+      const v = validateRepoPath(realRoot, candidate)
+      return v.ok ? v : { ok: false, reason: 'bin-outside-root' }
+    }
+    if (dir === realRoot) break
+    dir = dirname(dir)
+  }
+  return { ok: false, reason: 'tool-missing' }
+}
+
+// ── Runner ──────────────────────────────────────────────────────────────────
+
+// No secrets: PATH and a few inert variables only.
+export function scrubbedEnv() {
+  return { PATH: `${dirname(process.execPath)}:/usr/bin:/bin`, HOME: process.env.TMPDIR || '/tmp', CI: '1', NO_COLOR: '1' }
+}
+
+// Default runner. Resolves { code, stdout, stderr } or { error: 'timeout'|'output-cap'|'spawn-failed' }.
+export async function defaultRunner(bin, args, { cwd }) {
+  try {
+    const { stdout, stderr } = await execFileP(bin, args, {
+      cwd,
+      shell: false,
+      timeout: TIMEOUT_MS,
+      killSignal: 'SIGKILL',
+      maxBuffer: MAX_OUTPUT_BYTES,
+      env: scrubbedEnv(),
+      windowsHide: true,
+    })
+    return { code: 0, stdout, stderr }
+  } catch (e) {
+    if (e && e.code === 'ERR_CHILD_PROCESS_STDIO_MAXBUFFER') return { error: 'output-cap' }
+    if (e && e.killed) return { error: 'timeout' }
+    if (e && typeof e.code === 'number') return { code: e.code, stdout: e.stdout || '', stderr: e.stderr || '' }
+    return { error: 'spawn-failed' }
+  }
+}
+
+const clip = s => String(s || '').slice(0, EVIDENCE_CHARS)
+
+// ── Per-tool checks ─────────────────────────────────────────────────────────
+// Each returns { verdict, method, reason, evidence?, argv? }. `run` is injectable for tests.
+
+export async function checkTsc({ root, finding, diffFiles, run }) {
+  const file = resolveClaimedPath(root, finding.file, diffFiles)
+  if (!file.ok) return inconclusive('tsc', file.reason)
+  const cfg = findTsconfig(root, file.real)
+  if (!cfg.ok) return inconclusive('tsc', cfg.reason)
+  const bin = findLocalBin(root, 'tsc', file.real)
+  if (!bin.ok) return inconclusive('tsc', bin.reason)
+  const argv = ['--noEmit', '-p', cfg.rel, '--listFiles', '--pretty', 'false']
+  const r = await run(bin.real, argv, { cwd: realpathSync(root) })
+  if (r.error) return inconclusive('tsc', r.error)
+  const realRoot = realpathSync(root)
+  const range = parseLines(finding.lines)
+  const lines = String(r.stdout).split('\n')
+  if (r.code === 0) {
+    const listed = lines.some(l => {
+      const t = l.trim()
+      if (!t || t.includes('(') || !isAbsolute(t)) return false
+      try {
+        return realpathSync(t) === file.real
+      } catch {
+        return false
+      }
+    })
+    return listed
+      ? { verdict: 'refuted', method: 'tsc', reason: 'clean-run-file-covered', argv }
+      : inconclusive('tsc', 'file-not-in-program')
+  }
+  // Error lines: path(line,col): error TSnnnn: message
+  const hits = []
+  for (const l of lines) {
+    const m = l.match(/^(.+?)\((\d+),\d+\): error (TS\d+):/)
+    if (!m) continue
+    const p = isAbsolute(m[1]) ? m[1] : resolve(realRoot, m[1])
+    let real
+    try {
+      real = realpathSync(p)
+    } catch {
+      continue
+    }
+    if (real === file.real && inRange(Number(m[2]), range)) hits.push(l.trim())
+  }
+  return hits.length > 0
+    ? { verdict: 'confirmed', method: 'tsc', reason: 'tool-failed-at-claimed-location', evidence: clip(hits.join('\n')), argv }
+    : inconclusive('tsc', 'failure-not-at-claimed-location')
+}
+
+export async function checkVitest({ root, finding, run }) {
+  const test = findTestFile(root, finding)
+  if (!test) return inconclusive('vitest', 'no-test-file')
+  const bin = findLocalBin(root, 'vitest', test.real)
+  if (!bin.ok) return inconclusive('vitest', bin.reason)
+  const argv = ['run', '--reporter=json', '--coverage.enabled=false', test.rel]
+  const r = await run(bin.real, argv, { cwd: realpathSync(root) })
+  if (r.error) return inconclusive('vitest', r.error)
+  let report
+  try {
+    const out = String(r.stdout)
+    report = JSON.parse(out.slice(out.indexOf('{')))
+  } catch {
+    return inconclusive('vitest', 'unparseable-output')
+  }
+  let entry
+  for (const t of report.testResults || []) {
+    try {
+      if (realpathSync(t.name) === test.real) entry = t
+    } catch {
+      /* skip unresolvable names */
+    }
+  }
+  if (!entry) return inconclusive('vitest', 'file-did-not-run')
+  const results = entry.assertionResults || []
+  const failed = results.filter(a => a.status === 'failed')
+  const passed = results.filter(a => a.status === 'passed')
+  if (failed.length > 0) {
+    const evidence = clip(failed.map(a => `${a.fullName || a.title}: ${(a.failureMessages || [])[0] || ''}`).join('\n'))
+    return { verdict: 'confirmed', method: 'vitest', reason: 'test-failed-in-claimed-file', evidence, argv }
+  }
+  if (passed.length > 0 && r.code === 0) return { verdict: 'refuted', method: 'vitest', reason: 'tests-executed-and-passed', argv }
+  return inconclusive('vitest', 'no-tests-executed')
+}
+
+// Backticked tokens in the description that look like rule ids.
+export function namedRules(finding) {
+  const out = []
+  for (const m of String(finding.description || '').matchAll(/`((?:@[\w-]+\/)?[\w-]+(?:\/[\w-]+)?)`/g)) out.push(m[1])
+  return [...new Set(out)]
+}
+
+export async function checkEslint({ root, finding, diffFiles, run }) {
+  const file = resolveClaimedPath(root, finding.file, diffFiles)
+  if (!file.ok) return inconclusive('eslint', file.reason)
+  const bin = findLocalBin(root, 'eslint', file.real)
+  if (!bin.ok) return inconclusive('eslint', bin.reason)
+  const cwd = realpathSync(root)
+  const argv = ['--format', 'json', file.rel]
+  const r = await run(bin.real, argv, { cwd })
+  if (r.error) return inconclusive('eslint', r.error)
+  if (r.code !== 0 && r.code !== 1) return inconclusive('eslint', 'tool-crashed')
+  let results
+  try {
+    results = JSON.parse(r.stdout)
+  } catch {
+    return inconclusive('eslint', 'unparseable-output')
+  }
+  const entry = (results || []).find(x => {
+    try {
+      return realpathSync(x.filePath) === file.real
+    } catch {
+      return false
+    }
+  })
+  if (!entry) return inconclusive('eslint', 'file-not-linted')
+  const messages = entry.messages || []
+  if (messages.some(m => /ignored because of a matching ignore pattern/i.test(m.message || ''))) {
+    return inconclusive('eslint', 'file-ignored')
+  }
+  const range = parseLines(finding.lines)
+  const rules = namedRules(finding)
+  const errors = messages.filter(
+    m => m.severity === 2 && inRange(m.line, range) && (rules.length === 0 || rules.includes(m.ruleId)),
+  )
+  if (errors.length > 0) {
+    const evidence = clip(errors.map(m => `${entry.filePath}:${m.line}:${m.column} ${m.ruleId || ''} ${m.message}`).join('\n'))
+    return { verdict: 'confirmed', method: 'eslint', reason: 'tool-failed-at-claimed-location', evidence, argv }
+  }
+  if (r.code === 1) return inconclusive('eslint', 'failure-not-at-claimed-location')
+  // Clean file. That refutes only a NAMED rule that the config actually enables.
+  if (rules.length === 0) return inconclusive('eslint', 'clean-but-no-rule-named')
+  const cfgArgv = ['--print-config', file.rel]
+  const c = await run(bin.real, cfgArgv, { cwd })
+  if (c.error || c.code !== 0) return inconclusive('eslint', 'config-unreadable')
+  let cfg
+  try {
+    cfg = JSON.parse(c.stdout)
+  } catch {
+    return inconclusive('eslint', 'config-unreadable')
+  }
+  const on = v => {
+    const sev = Array.isArray(v) ? v[0] : v
+    return sev === 1 || sev === 2 || sev === 'warn' || sev === 'error'
+  }
+  const enabled = rules.filter(id => cfg.rules && on(cfg.rules[id]))
+  return enabled.length > 0
+    ? { verdict: 'refuted', method: 'eslint', reason: 'clean-run-rule-enabled', argv }
+    : inconclusive('eslint', 'named-rule-not-enabled')
+}
+
+// ── Orchestration ───────────────────────────────────────────────────────────
+
+async function gitOut(root, args, run) {
+  const r = await run('git', args, { cwd: root })
+  return r.error || r.code !== 0 ? null : String(r.stdout).trim()
+}
+
+// Verifies the checkout is the PR head and clean, runs each classifiable finding, and re-checks
+// the tree after every run. Returns one result per finding that has a deterministic check.
+export async function runChecks({ root, headSha, findings, diffFiles, run = defaultRunner }) {
+  const out = []
+  const head = await gitOut(root, ['rev-parse', 'HEAD'], run)
+  const dirty = await gitOut(root, ['status', '--porcelain'], run)
+  const blocked = head !== headSha ? 'head-mismatch' : dirty !== '' ? 'dirty-tree' : null
+  let mutated = false
+  for (const finding of findings) {
+    const cls = classifyFindingDetailed(finding)
+    if (!cls) continue
+    const { method, classifiedBy } = cls
+    let res
+    if (blocked) res = inconclusive(method, blocked)
+    else if (mutated) res = inconclusive(method, 'tree-mutated')
+    else {
+      const ctx = { root, finding, diffFiles, run }
+      try {
+        res = method === 'tsc' ? await checkTsc(ctx) : method === 'vitest' ? await checkVitest(ctx) : await checkEslint(ctx)
+      } catch (e) {
+        res = inconclusive(method, 'check-threw')
+      }
+      const after = await gitOut(root, ['status', '--porcelain'], run)
+      if (after !== '') {
+        mutated = true
+        res = inconclusive(method, 'tree-mutated')
+      }
+    }
+    if (res.verdict === 'refuted' && !refuteAllowed(method, classifiedBy, finding)) {
+      res = inconclusive(method, 'refute-needs-structured-claim')
+    }
+    const { argv, ...rest } = res
+    out.push({ id: finding.id, ...rest, classifiedBy, command: argv ? argv.join(' ') : undefined })
+  }
+  return out
+}
+
+function arg(name) {
+  const i = process.argv.indexOf(name)
+  return i >= 0 ? process.argv[i + 1] : undefined
+}
+
+async function main() {
+  const root = arg('--repo')
+  const headSha = arg('--head-sha')
+  const findingsPath = arg('--findings')
+  const diffPath = arg('--diff-files')
+  if (!root || !headSha || !findingsPath || !diffPath) {
+    console.error('usage: deterministic-check.mjs --repo <root> --head-sha <sha> --findings <file> --diff-files <file> [--out <file>]')
+    process.exit(2)
+  }
+  const findings = JSON.parse(readFileSync(findingsPath, 'utf8'))
+  const diffFiles = JSON.parse(readFileSync(diffPath, 'utf8'))
+  const results = await runChecks({ root, headSha, findings, diffFiles })
+  const json = JSON.stringify(results, null, 2)
+  const outPath = arg('--out')
+  if (outPath) writeFileSync(outPath, json)
+  else console.log(json)
+}
+
+if (import.meta.url === `file://${process.argv[1]}`) {
+  main().catch(e => {
+    console.error(String(e && e.message))
+    process.exit(1)
+  })
+}
